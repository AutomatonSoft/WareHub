# Local/dev ports
DEV_FRONTEND_PORT=8931
DEV_BACKEND_PORT=8932
DEV_POSTGRES_PORT=8933
DEV_SERVICES_PORT=8934
DEV_SERVICES_ALLOWED_HOSTS=*
DEV_POSTGRES_HOST=host.docker.internal
DEV_POSTGRES_HOST_PORT=15434
DEV_DB_TUNNEL_ENABLED=true
DEV_DB_TUNNEL_HOST=<DEV_DB_TUNNEL_HOST>
DEV_DB_TUNNEL_SSH_USER=root
DEV_DB_TUNNEL_REMOTE_HOST=127.0.0.1
DEV_DB_TUNNEL_REMOTE_PORT=15432
DEV_DB_TUNNEL_LOCAL_PORT=15434

# Shared local/dev runtime (single source for all repos)
APP_ENV=dev
APP_PORT=8932
DATABASE_URL=postgres://<DEV_POSTGRES_USER>:<DEV_POSTGRES_PASSWORD>@127.0.0.1:15434/sofortbot_shared_dev
BACKEND_ORIGIN=http://localhost:8932
NEXT_PUBLIC_API_BASE_URL=http://localhost:8932/api/v1
NEXT_PUBLIC_SERVICES_API_BASE_URL=http://localhost:8934
MOBILE_DEV_API_BASE_URL=http://192.168.0.103:8932
SECRET_KEY=django-insecure-change-me
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# Stage ports
STAGE_FRONTEND_PORT=8941
STAGE_BACKEND_PORT=8942
STAGE_POSTGRES_PORT=8943
STAGE_SERVICES_PORT=8944
STAGE_ORCHESTRATOR_PORT=8945
STAGE_SERVICES_ALLOWED_HOSTS=127.0.0.1,localhost,stagewarehub.automatonsoft.de

# Prod ports
PROD_FRONTEND_PORT=8951
PROD_BACKEND_PORT=8952
PROD_POSTGRES_PORT=8953
PROD_SERVICES_PORT=8954
PROD_ORCHESTRATOR_PORT=8955
PROD_SERVICES_ALLOWED_HOSTS=127.0.0.1,localhost,warehub.automatonsoft.de

# Images (stage/prod)
BACKEND_IMAGE=ghcr.io/ravilkadev0/sofortbot-backend
FRONTEND_IMAGE=ghcr.io/ravilkadev0/sofortbot-frontend
MOBILE_IMAGE=ghcr.io/ravilkadev0/sofortbot-mobile
SERVICES_IMAGE=ghcr.io/ravilkadev0/sofortbot-services
ORCHESTRATOR_IMAGE=ghcr.io/ravilkadev0/sb-sofort-orchestrator-service

# Public API base URLs for frontend runtime
STAGE_PUBLIC_API_BASE_URL=https://stage.example.com/api/v1
PROD_PUBLIC_API_BASE_URL=https://app.example.com/api/v1
STAGE_PUBLIC_SERVICES_API_BASE_URL=https://stage.example.com:8944
PROD_PUBLIC_SERVICES_API_BASE_URL=https://app.example.com:8954
STAGE_PUBLIC_ORCHESTRATOR_API_BASE_URL=https://stage.example.com:8945
PROD_PUBLIC_ORCHESTRATOR_API_BASE_URL=https://app.example.com:8955

# Version pins for production deployments (required: vX.Y.Z)
BACKEND_APP_VERSION=v0.0.0
FRONTEND_APP_VERSION=v0.0.0
MOBILE_APP_VERSION=v0.0.0
SERVICES_APP_VERSION=v0.0.0
ORCHESTRATOR_APP_VERSION=v0.0.0

# Stage image tags
BACKEND_STAGE_TAG=stage-latest
FRONTEND_STAGE_TAG=stage-latest
MOBILE_STAGE_TAG=stage-latest
SERVICES_STAGE_TAG=stage-latest
ORCHESTRATOR_STAGE_TAG=stage-latest

# Mobile app distribution metadata (used by backend/frontend)
MOBILE_STAGE_APP_VERSION=v0.0.0
MOBILE_STAGE_APK_URL=https://stage.example.com/downloads/warehubstage.apk
MOBILE_PROD_APP_VERSION=v0.0.0
MOBILE_PROD_APK_URL=https://prod.example.com/downloads/warehub.apk

# Postgres (stage/prod)
STAGE_POSTGRES_DB=sofortbot
STAGE_POSTGRES_USER=sofortbot
STAGE_POSTGRES_PASSWORD=<STAGE_POSTGRES_PASSWORD>
PROD_POSTGRES_DB=sofortbot
PROD_POSTGRES_USER=sofortbot
PROD_POSTGRES_PASSWORD=<PROD_POSTGRES_PASSWORD>

# Afterbuy credentials (used by backend in stage/prod)
AFTERBUY_JV_LOGIN=your_jv_login
AFTERBUY_JV_PASS=your_jv_password
AFTERBUY_XL_LOGIN=your_xl_login
AFTERBUY_XL_PASS=your_xl_password
AFTERBUY_JV_LOGIN_URL=https://login.afterbuy.de/
AFTERBUY_XL_LOGIN_URL=https://login.afterbuy.de/
AFTERBUY_JV_COOKIE_CACHE_FILE=.afterbuy_jv.cookie
AFTERBUY_XL_COOKIE_CACHE_FILE=.afterbuy_xl.cookie

# Backend Sentry (stage/prod)
BACKEND_STAGE_SENTRY_DSN=
BACKEND_STAGE_SENTRY_TRACES_SAMPLE_RATE=0.1
BACKEND_PROD_SENTRY_DSN=
BACKEND_PROD_SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend Sentry tuning (stage/prod)
FRONTEND_STAGE_SENTRY_TRACES_SAMPLE_RATE=0.1
FRONTEND_STAGE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
FRONTEND_STAGE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0
FRONTEND_PROD_SENTRY_TRACES_SAMPLE_RATE=0.1
FRONTEND_PROD_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
FRONTEND_PROD_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0

# Backend upload storage (FTP/local)
BACKEND_UPLOAD_STORAGE_BACKEND=ftp
BACKEND_UPLOAD_FTP_HOST=
BACKEND_UPLOAD_FTP_USER=
BACKEND_UPLOAD_FTP_PASS=
BACKEND_UPLOAD_FTP_PORT=21
BACKEND_UPLOAD_FTP_ROOT_DIR=warehub
BACKEND_UPLOAD_FTP_STORAGE_ROOT_DIR=
BACKEND_UPLOAD_FTP_AVATAR_DIR=avatar
BACKEND_STAGE_UPLOAD_FTP_PUBLIC_BASE_URL=
BACKEND_PROD_UPLOAD_FTP_PUBLIC_BASE_URL=

# Orchestrator runtime tuning
STAGE_ORCHESTRATOR_DATABASE_SERVICE_BASE_URL=http://services:8000
PROD_ORCHESTRATOR_DATABASE_SERVICE_BASE_URL=http://services:8000
ORCHESTRATOR_HTTP_TIMEOUT_SECONDS=8
ORCHESTRATOR_HTTP_RETRIES=2
ORCHESTRATOR_IDEMPOTENCY_TTL_SECONDS=86400
ORCHESTRATOR_SERVICE_NAME=sb-sofort-orchestrator-service
ORCHESTRATOR_LOG_LEVEL=INFO

# MinIO local
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=<MINIO_ROOT_PASSWORD>
