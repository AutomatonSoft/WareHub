# Infra-local overrides for Slice 3B.
# Do not commit real values. Copy only the keys you need into a local untracked file.

# Local dev defaults for hybrid mode
DEV_FRONTEND_PORT=8931
DEV_BACKEND_PORT=8932
DEV_POSTGRES_PORT=8933
DEV_SERVICES_PORT=8934
DEV_ORCHESTRATOR_PORT=8935
DEV_REDIS_PORT=8936
DEV_RABBITMQ_PORT=8937
DEV_RABBITMQ_MANAGEMENT_PORT=15672
DEV_MINIO_API_PORT=9000
DEV_MINIO_CONSOLE_PORT=9001

DEV_POSTGRES_DB=warehub
DEV_POSTGRES_USER=warehub
DEV_POSTGRES_PASSWORD=warehub
DEV_POSTGRES_HOST=localhost
DEV_POSTGRES_HOST_PORT=8933

DEV_RABBITMQ_USER=warehub
DEV_RABBITMQ_PASSWORD=warehub
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME

BACKEND_ORIGIN=http://localhost:8932
SERVICES_ORIGIN=http://localhost:8934
ORCHESTRATOR_ORIGIN=http://localhost:8935
NEXT_PUBLIC_API_BASE_URL=http://localhost:8932/api/v1
NEXT_PUBLIC_SERVICES_API_BASE_URL=http://localhost:8934/api/v1
NEXT_PUBLIC_ORCHESTRATOR_API_BASE_URL=http://localhost:8935/api/v1
MOBILE_DEV_API_BASE_URL=http://127.0.0.1:8932/api/v1

# Optional legacy shared DB tunnel mode. Disabled by default.
DEV_DB_TUNNEL_ENABLED=false
DEV_DB_TUNNEL_HOST=CHANGE_ME
DEV_DB_TUNNEL_SSH_USER=CHANGE_ME
DEV_DB_TUNNEL_REMOTE_HOST=127.0.0.1
DEV_DB_TUNNEL_REMOTE_PORT=CHANGE_ME
DEV_DB_TUNNEL_LOCAL_PORT=CHANGE_ME

# Stage deployment: only the gateway is published on the host.
STAGE_GATEWAY_PORT=8940
STAGE_PUBLIC_API_BASE_URL=https://stage.example.com/api/v1
STAGE_PUBLIC_SERVICES_API_BASE_URL=https://stage.example.com/api/v1/services
STAGE_PUBLIC_ORCHESTRATOR_API_BASE_URL=https://stage.example.com/api/v1/orchestrator
STAGE_DOMAIN=stage.example.com

# Production deployment: only the gateway is published on the host.
PROD_GATEWAY_PORT=8950
PROD_PUBLIC_API_BASE_URL=https://example.com/api/v1
PROD_PUBLIC_SERVICES_API_BASE_URL=https://example.com/api/v1/services
PROD_PUBLIC_ORCHESTRATOR_API_BASE_URL=https://example.com/api/v1/orchestrator
PROD_DOMAIN=example.com

# Image placeholders for later deploy slices
BACKEND_IMAGE=ghcr.io/example/warehub-backend
FRONTEND_IMAGE=ghcr.io/example/warehub-frontend
MOBILE_IMAGE=ghcr.io/example/warehub-mobile
SERVICES_IMAGE=ghcr.io/example/warehub-database-service
ORCHESTRATOR_IMAGE=ghcr.io/example/warehub-orchestrator

# Release placeholders
BACKEND_APP_VERSION=v0.0.0
FRONTEND_APP_VERSION=v0.0.0
MOBILE_APP_VERSION=v0.0.0
SERVICES_APP_VERSION=v0.0.0
ORCHESTRATOR_APP_VERSION=v0.0.0
