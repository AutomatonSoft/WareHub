# Local frontend template for WareHub monorepo.
# Copy to an untracked local file only when you need to run the frontend manually:
#   apps/frontend/.env.local
NODE_ENV=development
PORT=8931
BACKEND_ORIGIN=http://localhost:8932
BACKEND_INTERNAL_API_BASE_URL=http://127.0.0.1:8932/api/v1
SERVICES_ORIGIN=http://localhost:8934
NEXT_PUBLIC_API_BASE_URL=http://localhost:8932/api/v1
NEXT_PUBLIC_SERVICES_API_BASE_URL=http://localhost:8934/api/v1
NEXT_PUBLIC_ORCHESTRATOR_API_BASE_URL=http://localhost:8935/api/v1
NEXT_PUBLIC_APP_ENV=dev
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0
FRONTEND_SENTRY_DSN=
FRONTEND_SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_ANDROID_APK_URL=https://example.com/downloads/warehub.apk
NEXT_PUBLIC_ANDROID_APK_URL_STAGE=https://stage.example.com/downloads/warehub-stage.apk
NEXT_PUBLIC_ANDROID_APK_URL_PROD=https://example.com/downloads/warehub.apk

# E2E auth placeholders for local Playwright runs only.
E2E_LOGIN=CHANGE_ME
E2E_PASSWORD=CHANGE_ME
