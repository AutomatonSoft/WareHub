{
  "name": "sofortbot-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8931",
    "build": "next build",
    "start": "next start -p 8931",
    "lint": "eslint .",
    "typecheck": "next typegen && node -e \"const fs=require('fs'); const p='.next/types/cache-life.d.ts'; if(!fs.existsSync(p)){fs.mkdirSync('.next/types',{recursive:true}); fs.writeFileSync(p,'export {}');}\" && tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.mjs",
    "i18n:check": "node tools/check-i18n-keys.mjs",
    "test:e2e": "playwright test",
    "e2e:preflight": "node tools/check-e2e-preflight.mjs",
    "test:e2e:smoke": "npm run -s e2e:preflight && playwright test e2e/auth-guard.spec.ts e2e/authenticated-smoke.spec.ts e2e/inventory-marketplace.spec.ts e2e/profile-sofort-list.spec.ts e2e/sofort-list-advanced.spec.ts e2e/backend-health-ui.spec.ts e2e/channels.spec.ts e2e/cross-channel-flow.spec.ts e2e/create-edit-flow.spec.ts e2e/xljv-edit-flow.spec.ts e2e/a11y-keyboard-smoke.spec.ts e2e/a11y-table-filters.spec.ts e2e/a11y-axe.spec.ts",
    "test:e2e:orchestrator-mocks": "playwright test e2e/create-edit-flow.spec.ts -g orchestrator",
    "test:e2e:table": "npm run -s e2e:preflight && playwright test e2e/inventory-marketplace.spec.ts e2e/profile-sofort-list.spec.ts e2e/sofort-list-advanced.spec.ts e2e/table-query-contract.spec.ts e2e/table-export-format.spec.ts",
    "test:e2e:flaky": "npm run -s e2e:preflight && playwright test --project=chromium-flaky --pass-with-no-tests",
    "test:e2e:mutation": "playwright test e2e/inventory-crud-isolated.spec.ts",
    "test:e2e:visual": "playwright test e2e/visual-regression.spec.ts",
    "test:e2e:visual:update": "playwright test e2e/visual-regression.spec.ts --update-snapshots",
    "visual:budget:check": "node tools/check-visual-snapshot-budget.mjs",
    "test:e2e:perf": "playwright test e2e/performance-regression.spec.ts",
    "visual:baseline:check": "node tools/check-visual-baseline.mjs",
    "openapi:pull": "node tools/pull-openapi-schema.mjs",
    "openapi:types": "node tools/generate-openapi-types.mjs",
    "openapi:orchestrator:types": "node tools/generate-orchestrator-openapi-types.mjs",
    "openapi:generate": "npm run openapi:pull && npm run openapi:types",
    "openapi:check": "node tools/check-openapi-drift.mjs",
    "openapi:orchestrator:check": "node tools/check-orchestrator-openapi-drift.mjs",
    "perf:check": "node tools/check-performance-budget.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@sentry/nextjs": "^10.42.0",
    "@tanstack/react-query": "^5.100.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.574.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-image-crop": "^11.0.10",
    "recharts": "^3.8.1",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.55.1",
    "@storybook/nextjs": "^10.4.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "22.15.21",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.1.6",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.5.8",
    "storybook": "^10.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8.3"
  }
}
