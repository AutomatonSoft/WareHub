# Source of truth:
#   ../sofortbot-infra/.env
# Keep this file only as a fallback template for standalone backend runs.
APP_ENV=dev
APP_PORT=8932
DATABASE_URL=postgres://sofortbot:sofortbot@localhost:8933/sofortbot
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sofortbot
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
ADMIN_USERNAME=admin
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_secure_password
ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_ON_STARTUP=false
BOOTSTRAP_ADMIN_ENFORCE_ROLE=false
AUTH_TOKEN_TTL_HOURS=24
PASSWORD_RESET_CODE_TTL_MINUTES=10
CORS_ALLOW_ORIGINS=http://localhost:8931
EXPOSE_UPLOADS_PUBLIC=true
UPLOAD_STORAGE_BACKEND=local
UPLOAD_FTP_HOST=
UPLOAD_FTP_USER=
UPLOAD_FTP_PASS=
UPLOAD_FTP_PORT=21
UPLOAD_FTP_ROOT_DIR=warehub
UPLOAD_FTP_STORAGE_ROOT_DIR=warehub
UPLOAD_FTP_AVATAR_DIR=avatar
UPLOAD_FTP_PUBLIC_BASE_URL=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Warehub <no-reply@example.com>
SMTP_INSECURE=false
AFTERBUY_JV_LOGIN=your_jv_login
AFTERBUY_JV_PASS=your_jv_password
AFTERBUY_XL_LOGIN=your_xl_login
AFTERBUY_XL_PASS=your_xl_password
AFTERBUY_JV_LOGIN_URL=https://login.afterbuy.de/
AFTERBUY_XL_LOGIN_URL=https://login.afterbuy.de/
AFTERBUY_JV_COOKIE_CACHE_FILE=.afterbuy_jv.cookie
AFTERBUY_XL_COOKIE_CACHE_FILE=.afterbuy_xl.cookie
PRODUCTBASE_JV_JSON_DIR=/var/lib/productbaseapi/data/JV/JV_LISTER/JV_NEW/JSON
PRODUCTBASE_XL_JSON_DIR=/var/lib/productbaseapi/data/XL/XL_LISTER/XL_NEW/JSON
PRODUCTBASE_IMAGE_BASE_URL=
MOBILE_STAGE_APP_VERSION=v0.0.0
MOBILE_STAGE_APK_URL=
MOBILE_PROD_APP_VERSION=v0.0.0
MOBILE_PROD_APK_URL=
