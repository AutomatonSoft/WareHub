SENTRY_PROJECT=CHANGE_ME
SENTRY_TRACES_SAMPLE_RATE=0.1

# Mobile Distribution
# Mobile app download URLs and published version metadata.
MOBILE_PROD_APK_URL=https://example.com/downloads/warehub.apk
MOBILE_PROD_APP_VERSION=v0.0.0
MOBILE_STAGE_APK_URL=https://stage.example.com/downloads/warehub-stage.apk
MOBILE_STAGE_APP_VERSION=v0.0.0
NEXT_PUBLIC_ANDROID_APK_URL=https://example.com/downloads/warehub.apk
NEXT_PUBLIC_ANDROID_APK_URL_PROD=https://example.com/downloads/warehub.apk
NEXT_PUBLIC_ANDROID_APK_URL_STAGE=https://stage.example.com/downloads/warehub-stage.apk

# Marketplace Core Integrations
# Shared marketplace credentials and automation service settings.
AFTERBUY_JV_COOKIE_CACHE_FILE=.afterbuy_jv.cookie
AFTERBUY_JV_LOGIN=CHANGE_ME
AFTERBUY_JV_LOGIN_URL=https://www.afterbuy.de/afterbuy/shopbetreiber/
AFTERBUY_JV_PASS=CHANGE_ME
AFTERBUY_XL_COOKIE_CACHE_FILE=.afterbuy_xl.cookie
AFTERBUY_XL_LOGIN=CHANGE_ME
AFTERBUY_XL_LOGIN_URL=https://www.afterbuy.de/afterbuy/shopbetreiber/
AFTERBUY_XL_PASS=CHANGE_ME
HOOD_API_BASE_URL=https://example.com
HOOD_API_CONNECT_TIMEOUT=8
HOOD_API_PATCH_ENDPOINT=/api/items/by-ean
HOOD_API_READ_TIMEOUT=30
HOOD_FTP_BASE_DIR=warehub/images/hood
HOOD_FTP_CONNECT_TIMEOUT=15
HOOD_FTP_HOST=CHANGE_ME
HOOD_FTP_PASSIVE=true
HOOD_FTP_PASSWORD=CHANGE_ME
HOOD_FTP_PORT=21
HOOD_FTP_PUBLIC_BASE_URL=https://example.com/warehub/images
HOOD_FTP_USE_TLS=false
HOOD_FTP_USER=CHANGE_ME
HOOD_LOGIN=CHANGE_ME
HOOD_PASSWORD=CHANGE_ME
HOOD_VALIDATE_UPLOADED_IMAGE_URLS=false
OPENAI_API_KEY=CHANGE_ME
OPENAI_TRANSLATION_MODEL=gpt-5-mini

# Deploy Public Endpoints
# Public domains and externally visible entrypoints for stage and production.
PROD_DOMAIN=warehub.automatonsoft.de
PROD_GATEWAY_PORT=8950
PROD_PUBLIC_API_BASE_URL=https://warehub.automatonsoft.de/api/v1
PROD_PUBLIC_ORCHESTRATOR_API_BASE_URL=https://warehub.automatonsoft.de/api/v1/orchestrator
PROD_PUBLIC_SERVICES_API_BASE_URL=https://warehub.automatonsoft.de/api/v1/services
STAGE_DOMAIN=stagewarehub.automatonsoft.de
STAGE_GATEWAY_PORT=8940
STAGE_PUBLIC_API_BASE_URL=https://stagewarehub.automatonsoft.de/api/v1
STAGE_PUBLIC_ORCHESTRATOR_API_BASE_URL=https://stagewarehub.automatonsoft.de/api/v1/orchestrator
STAGE_PUBLIC_SERVICES_API_BASE_URL=https://stagewarehub.automatonsoft.de/api/v1/services

# Deploy Runtime Contracts
# Stage and production runtime settings consumed by containers and services.
STAGE_BACKEND_AUTH_BASE_URL=http://backend:8932/api/v1
STAGE_BACKEND_SESSION_BRIDGE_ALLOWED_HOSTS=stagewarehub.automatonsoft.de,localhost,127.0.0.1
STAGE_ORCHESTRATOR_DATABASE_SERVICE_BASE_URL=http://services:8000
STAGE_ORCHESTRATOR_SERVICE_ALLOWED_HOSTS=services,localhost,127.0.0.1
STAGE_ORCHESTRATOR_SERVICE_AUTH_TOKEN=__SET_OUTSIDE_GIT__
STAGE_POSTGRES_DB=warehub_stage
STAGE_POSTGRES_PASSWORD=__SET_OUTSIDE_GIT__
STAGE_POSTGRES_USER=warehub_stage
STAGE_RUN_MIGRATIONS_ON_STARTUP=false
STAGE_SERVICES_ALLOWED_HOSTS=stagewarehub.automatonsoft.de,services,localhost,127.0.0.1

# Images And Release Markers
# Image repositories and release tags or versions used for deploys.
BACKEND_APP_VERSION=v0.0.0
BACKEND_IMAGE=ghcr.io/ravilkadev0/warehub/backend
