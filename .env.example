FRONTEND_PROD_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0
FRONTEND_PROD_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
