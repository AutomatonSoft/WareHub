# WareHub root public env example.
# Real values belong only in repo-root .env. Use CHANGE_ME for local secrets and __SET_OUTSIDE_GIT__ for stage/prod or operator-provided values.

# Local Dev Network
# Local-only ports, host bindings, and host-facing service URLs.
API_BASE_URL=http://127.0.0.1:8932/api/v1
BACKEND_INTERNAL_API_BASE_URL=http://127.0.0.1:8932/api/v1
BACKEND_ORIGIN=http://localhost:8932
DATABASE_SERVICE_BASE_URL=http://localhost:8934
DEV_BACKEND_PORT=8932
DEV_FRONTEND_PORT=8931
DEV_MINIO_API_PORT=9000
DEV_MINIO_CONSOLE_PORT=9001
DEV_ORCHESTRATOR_PORT=8935
DEV_POSTGRES_HOST_PORT=8933
DEV_POSTGRES_PORT=8933
DEV_RABBITMQ_MANAGEMENT_PORT=15672
DEV_RABBITMQ_PORT=8937
DEV_REDIS_PORT=8936
DEV_SERVICES_PORT=8934
MOBILE_DEV_API_BASE_URL=http://127.0.0.1:8932/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8932/api/v1
NEXT_PUBLIC_APP_ENV=dev
NEXT_PUBLIC_ORCHESTRATOR_API_BASE_URL=http://localhost:8935
NEXT_PUBLIC_SERVICES_API_BASE_URL=http://localhost:8934/api/v1
NODE_ENV=development
ORCHESTRATOR_ORIGIN=http://localhost:8935
PORT=8931
PYTHONPATH=.
SERVICES_ORIGIN=http://localhost:8934

# Local Dev Infrastructure
# Local dependency credentials, database wiring, and optional tunnel settings.
DATABASE_URL=postgres://warehub:CHANGE_ME@localhost:8933/warehub
DEV_DB_TUNNEL_ENABLED=false
DEV_POSTGRES_DB=warehub
DEV_POSTGRES_HOST=localhost
DEV_POSTGRES_PASSWORD=warehub
DEV_POSTGRES_USER=warehub
DEV_RABBITMQ_PASSWORD=warehub
DEV_RABBITMQ_USER=warehub
EAN_MAP_DATABASE_NAME=sofortbot_ean_map
EAN_MAP_DATABASE_URL=postgresql://warehub:CHANGE_ME@localhost:8933/sofortbot_ean_map
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=minio
POSTGRES_DB=warehub
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=8933
POSTGRES_USER=warehub
SKIP_DB_MIGRATIONS=true
WAREHUB_LOCAL_DEV_ROOT_ENV_ACTIVE=true

# Application Runtime
# Runtime flags and settings shared by local app processes.
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_HOSTS_EXTRA=
APP_ENV=dev
APP_PORT=8932
AUTH_TOKEN_TTL_HOURS=24
AUTO_ORPHAN_PHOTO_CLEANUP_INTERVAL_MINUTES=60
AUTO_ORPHAN_PHOTO_CLEANUP_LIMIT=200
AUTO_ORPHAN_PHOTO_CLEANUP_RETENTION_DAYS=7
BACKEND_AUTH_BASE_URL=http://127.0.0.1:8932/api/v1
BACKEND_SESSION_BRIDGE_ALLOWED_HOSTS=localhost,127.0.0.1
BOOTSTRAP_ADMIN_ENFORCE_ROLE=false
BOOTSTRAP_ADMIN_ON_STARTUP=false
CORS_ALLOW_ORIGINS=http://localhost:8931,http://127.0.0.1:8931
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=1000
DEBUG=true
EXPOSE_UPLOADS_PUBLIC=true
ORCHESTRATOR_LOG_LEVEL=INFO
ORCHESTRATOR_SERVICE_ALLOWED_HOSTS=localhost,127.0.0.1
ORCHESTRATOR_SERVICE_AUTH_TOKEN=warehub-local-orchestrator
ORCHESTRATOR_SERVICE_NAME=sb-sofort-orchestrator-service
SERVICES_LOG_LEVEL=INFO
SERVICES_SERVICE_NAME=warehub-database-service
SECRET_KEY=CHANGE_ME
SERVICES_SECRET_KEY=CHANGE_ME
UPLOAD_MAX_BODY_BYTES=10485760

# Telegram placeholders
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=

# Admin And Test Access
# Bootstrap admin and optional local E2E credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_USERNAME=admin
E2E_LOGIN=CHANGE_ME
E2E_PASSWORD=CHANGE_ME

# Email And Password Reset
# SMTP and password-reset settings by environment.
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_LOG_CODES=false
SMTP_FROM=no-reply@example.test
SMTP_HOST=localhost
SMTP_INSECURE=true
SMTP_PASSWORD=CHANGE_ME
SMTP_PORT=1025
SMTP_USERNAME=CHANGE_ME
STAGE_PASSWORD_RESET_CODE_TTL_MINUTES=10
STAGE_PASSWORD_RESET_LOG_CODES=false
STAGE_SMTP_FROM=no-reply@stagewarehub.automatonsoft.de
STAGE_SMTP_HOST=__SET_OUTSIDE_GIT__
STAGE_SMTP_INSECURE=false
STAGE_SMTP_PASSWORD=__SET_OUTSIDE_GIT__
STAGE_SMTP_PORT=587
STAGE_SMTP_USERNAME=__SET_OUTSIDE_GIT__

# Storage And Media
# Upload backends, FTP media paths, and local object storage settings.
BACKEND_STAGE_UPLOAD_FTP_PUBLIC_BASE_URL=https://stagewarehub.automatonsoft.de/uploads
BACKEND_UPLOAD_FTP_AVATAR_DIR=avatar
BACKEND_UPLOAD_FTP_HOST=__SET_OUTSIDE_GIT__
BACKEND_UPLOAD_FTP_PASS=__SET_OUTSIDE_GIT__
BACKEND_UPLOAD_FTP_PORT=21
BACKEND_UPLOAD_FTP_ROOT_DIR=warehub
BACKEND_UPLOAD_FTP_STORAGE_ROOT_DIR=storage
BACKEND_UPLOAD_FTP_USER=__SET_OUTSIDE_GIT__
BACKEND_UPLOAD_STORAGE_BACKEND=ftp
PRODUCTBASE_IMAGE_BASE_URL=https://example.com
PRODUCTBASE_JV_JSON_DIR=CHANGE_ME
PRODUCTBASE_XL_JSON_DIR=CHANGE_ME
S3_ACCESS_KEY=minio
S3_BUCKET=warehub-local
S3_ENDPOINT=http://localhost:9000
S3_SECRET_KEY=CHANGE_ME
UPLOAD_FTP_AVATAR_DIR=avatar
UPLOAD_FTP_HOST=CHANGE_ME
UPLOAD_FTP_PASS=CHANGE_ME
UPLOAD_FTP_PORT=21
UPLOAD_FTP_PUBLIC_BASE_URL=https://example.com
UPLOAD_FTP_ROOT_DIR=warehub
UPLOAD_FTP_STORAGE_ROOT_DIR=warehub
UPLOAD_FTP_USER=CHANGE_ME
UPLOAD_STORAGE_BACKEND=local

# Observability
# Sentry and browser/server observability configuration.
BACKEND_PROD_SENTRY_DSN=
BACKEND_PROD_SENTRY_TRACES_SAMPLE_RATE=0.1
BACKEND_SENTRY_DSN=
BACKEND_SENTRY_TRACES_SAMPLE_RATE=1.0
