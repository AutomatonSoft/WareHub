# WareHub local root env contract.
# This is the only manually maintained local env template.
# Real local values belong in repo-root .env only and must never be committed.

# Local dependency ports
DEV_FRONTEND_PORT=8931
DEV_BACKEND_PORT=8932
DEV_POSTGRES_PORT=8933
DEV_SERVICES_PORT=8934
DEV_ORCHESTRATOR_PORT=8935
DEV_REDIS_PORT=8936
DEV_RABBITMQ_PORT=8937
DEV_RABBITMQ_MANAGEMENT_PORT=15672
DEV_MINIO_API_PORT=9000
DEV_MINIO_CONSOLE_PORT=9001

# Local dependency credentials
DEV_POSTGRES_DB=warehub
DEV_POSTGRES_USER=warehub
DEV_POSTGRES_PASSWORD=warehub
DEV_POSTGRES_HOST=localhost
DEV_POSTGRES_HOST_PORT=8933
DEV_RABBITMQ_USER=warehub
DEV_RABBITMQ_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME

# Frontend/browser and local service origins
BACKEND_ORIGIN=http://localhost:8932
SERVICES_ORIGIN=http://localhost:8934
ORCHESTRATOR_ORIGIN=http://localhost:8935
NEXT_PUBLIC_API_BASE_URL=http://localhost:8932/api/v1
NEXT_PUBLIC_SERVICES_API_BASE_URL=http://localhost:8934
NEXT_PUBLIC_ORCHESTRATOR_API_BASE_URL=http://localhost:8935
# Server-side OpenAPI aggregator uses only *_INTERNAL_API_BASE_URL, then legacy server-only *_API_BASE_URL, then local defaults.
BACKEND_INTERNAL_API_BASE_URL=http://127.0.0.1:8932/api/v1
BACKEND_API_BASE_URL=http://localhost:8932/api/v1
SERVICES_INTERNAL_API_BASE_URL=http://services:8000/api/v1
SERVICES_API_BASE_URL=http://localhost:8934
ORCHESTRATOR_INTERNAL_API_BASE_URL=http://orchestrator:8011/api/v1
ORCHESTRATOR_API_BASE_URL=http://localhost:8935
MOBILE_DEV_API_BASE_URL=http://127.0.0.1:8932/api/v1
NEXT_PUBLIC_APP_ENV=dev
NEXT_PUBLIC_APP_VERSION=v0.0.0-local
NEXT_PUBLIC_ANDROID_APK_URL=https://example.com/downloads/warehub.apk
NEXT_PUBLIC_ANDROID_APK_URL_STAGE=https://stage.example.com/downloads/warehub-stage.apk
NEXT_PUBLIC_ANDROID_APK_URL_PROD=https://example.com/downloads/warehub.apk
MOBILE_STAGE_APP_VERSION=v0.0.0
MOBILE_STAGE_APK_URL=https://stage.example.com/downloads/app.apk
MOBILE_PROD_APP_VERSION=v0.0.0
MOBILE_PROD_APK_URL=https://example.com/downloads/app.apk

# Backend local runtime
WAREHUB_LOCAL_DEV_ROOT_ENV_ACTIVE=true
APP_ENV=dev
APP_PORT=8932
DATABASE_URL=postgres://warehub:CHANGE_ME@localhost:8933/warehub
POSTGRES_DB=warehub
POSTGRES_USER=warehub
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=localhost
POSTGRES_PORT=8933
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=1000
SKIP_DB_MIGRATIONS=true
CORS_ALLOW_ORIGINS=http://localhost:8931,http://127.0.0.1:8931
AUTH_TOKEN_TTL_HOURS=24
UPLOAD_MAX_BODY_BYTES=10485760
AUTO_ORPHAN_PHOTO_CLEANUP_RETENTION_DAYS=7
AUTO_ORPHAN_PHOTO_CLEANUP_LIMIT=200
AUTO_ORPHAN_PHOTO_CLEANUP_INTERVAL_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_ON_STARTUP=false
BOOTSTRAP_ADMIN_ENFORCE_ROLE=false

# Password reset and SMTP
# Prefer plain mailbox sender in .env.
SMTP_HOST=wXXXXXXX.kasserver.com
SMTP_PORT=587
SMTP_USERNAME=mailbox@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=mailbox@example.com
SMTP_INSECURE=false
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_LOG_CODES=false

# Uploads and storage
EXPOSE_UPLOADS_PUBLIC=true
UPLOAD_STORAGE_BACKEND=local
UPLOAD_FTP_HOST=CHANGE_ME
UPLOAD_FTP_USER=CHANGE_ME
UPLOAD_FTP_PASS=CHANGE_ME
UPLOAD_FTP_PORT=21
UPLOAD_FTP_ROOT_DIR=warehub
UPLOAD_FTP_STORAGE_ROOT_DIR=warehub
UPLOAD_FTP_AVATAR_DIR=avatar
UPLOAD_FTP_PUBLIC_BASE_URL=https://example.com
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=warehub-local
S3_ACCESS_KEY=minio
S3_SECRET_KEY=CHANGE_ME

# Django database-service local runtime
SECRET_KEY=CHANGE_ME
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:8931,http://127.0.0.1:8931
CSRF_TRUSTED_ORIGINS=http://localhost:8931,http://127.0.0.1:8931
BACKEND_AUTH_BASE_URL=http://127.0.0.1:8932/api/v1
BACKEND_SESSION_BRIDGE_ALLOWED_HOSTS=localhost,127.0.0.1
EAN_MAP_DATABASE_URL=postgresql://warehub:CHANGE_ME@localhost:8933/sofortbot_ean_map
EAN_MAP_DATABASE_NAME=sofortbot_ean_map
DEV_ALLOW_ALL=false

# Orchestrator local runtime
PYTHONPATH=.
DATABASE_SERVICE_BASE_URL=http://localhost:8934
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8935
ORCHESTRATOR_HTTP_TIMEOUT_SECONDS=8
ORCHESTRATOR_HTTP_RETRIES=2
ORCHESTRATOR_IDEMPOTENCY_TTL_SECONDS=86400
ORCHESTRATOR_IDEMPOTENCY_SQLITE_PATH=./data/orchestrator_idempotency.sqlite3
ORCHESTRATOR_JOBS_SQLITE_PATH=./data/orchestrator_jobs.sqlite3
ORCHESTRATOR_ENABLE_JOB_WORKER=1
ORCHESTRATOR_JOB_WORKER_POLL_INTERVAL_SECONDS=0.2
ORCHESTRATOR_ENABLE_RECONCILIATION_SCHEDULER=0
ORCHESTRATOR_RECONCILIATION_SCHEDULER_POLL_INTERVAL_SECONDS=5
ORCHESTRATOR_RECONCILIATION_REPORTS_TTL_SECONDS=604800
ORCHESTRATOR_RECONCILIATION_REPORTS_MAX_PER_EAN=50
ORCHESTRATOR_JOBS_BATCH_MAX_ITEMS=100
ORCHESTRATOR_JOBS_STATUS_BATCH_MAX_ITEMS=200
ORCHESTRATOR_JOB_INTAKE_RATE_LIMIT_WINDOW_SECONDS=60
ORCHESTRATOR_JOB_INTAKE_RATE_LIMIT_MAX_JOBS=10000
ORCHESTRATOR_JOB_INTAKE_RATE_LIMIT_MAX_URGENT_JOBS=10000
ORCHESTRATOR_JOB_INTAKE_RATE_LIMIT_MAX_NORMAL_JOBS=10000
ORCHESTRATOR_JOB_INTAKE_RATE_LIMIT_MAX_BACKGROUND_JOBS=10000
ORCHESTRATOR_ENABLE_CIRCUIT_BREAKER=1
ORCHESTRATOR_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
ORCHESTRATOR_CIRCUIT_BREAKER_OPEN_SECONDS=10
ORCHESTRATOR_ENABLE_CHANNEL_LIMITER=1
ORCHESTRATOR_CHANNEL_LIMITER_MAX_INFLIGHT_PER_KEY=1
ORCHESTRATOR_SERVICE_NAME=warehub-orchestrator
ORCHESTRATOR_LOG_LEVEL=INFO

# Sentry and observability
SENTRY_DSN=CHANGE_ME
NEXT_PUBLIC_SENTRY_DSN=CHANGE_ME
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0
SENTRY_ORG=CHANGE_ME
SENTRY_PROJECT=CHANGE_ME
SENTRY_AUTH_TOKEN=CHANGE_ME

# Integrations used locally when explicitly configured
AFTERBUY_JV_LOGIN=CHANGE_ME
AFTERBUY_JV_PASS=CHANGE_ME
AFTERBUY_XL_LOGIN=CHANGE_ME
AFTERBUY_XL_PASS=CHANGE_ME
AFTERBUY_JV_LOGIN_URL=https://example.com
AFTERBUY_XL_LOGIN_URL=https://example.com
AFTERBUY_JV_COOKIE_CACHE_FILE=.afterbuy_jv.cookie
AFTERBUY_XL_COOKIE_CACHE_FILE=.afterbuy_xl.cookie
OPENAI_API_KEY=CHANGE_ME
OPENAI_TRANSLATION_MODEL=gpt-5-mini
HOOD_API_BASE_URL=https://example.com
HOOD_API_PATCH_ENDPOINT=/api/items/by-ean
HOOD_API_CONNECT_TIMEOUT=8
HOOD_API_READ_TIMEOUT=30
HOOD_LOGIN=CHANGE_ME
HOOD_PASSWORD=CHANGE_ME
HOOD_FTP_HOST=CHANGE_ME
HOOD_FTP_PORT=21
HOOD_FTP_USER=CHANGE_ME
HOOD_FTP_PASSWORD=CHANGE_ME
HOOD_FTP_BASE_DIR=warehub/images/hood
HOOD_FTP_PUBLIC_BASE_URL=https://example.com/warehub/images
HOOD_FTP_USE_TLS=false
HOOD_FTP_PASSIVE=true
HOOD_FTP_CONNECT_TIMEOUT=15
HOOD_VALIDATE_UPLOADED_IMAGE_URLS=false

# Optional local E2E auth
E2E_LOGIN=CHANGE_ME
E2E_PASSWORD=CHANGE_ME

# Optional local tunnel fallback. Disabled by default.
DEV_DB_TUNNEL_ENABLED=false
DEV_DB_TUNNEL_HOST=CHANGE_ME
DEV_DB_TUNNEL_SSH_USER=CHANGE_ME
DEV_DB_TUNNEL_REMOTE_HOST=127.0.0.1
DEV_DB_TUNNEL_REMOTE_PORT=CHANGE_ME
DEV_DB_TUNNEL_LOCAL_PORT=CHANGE_ME

# Stage placeholders kept only as sanitized deploy-template references.
STAGE_DOMAIN=stage.example.com
STAGE_FRONTEND_PORT=8941
STAGE_BACKEND_PORT=8942
STAGE_POSTGRES_PORT=8943
STAGE_SERVICES_PORT=8944
STAGE_ORCHESTRATOR_PORT=8945
STAGE_PUBLIC_API_BASE_URL=https://stage.example.com/api/v1
STAGE_PUBLIC_SERVICES_API_BASE_URL=https://stage.example.com:8944
STAGE_PUBLIC_ORCHESTRATOR_API_BASE_URL=https://stage.example.com:8945
BACKEND_STAGE_SENTRY_DSN=CHANGE_ME
BACKEND_STAGE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Production placeholders kept only as sanitized deploy-template references.
PROD_DOMAIN=example.com
PROD_FRONTEND_PORT=8951
PROD_BACKEND_PORT=8952
PROD_POSTGRES_PORT=8953
PROD_SERVICES_PORT=8954
PROD_ORCHESTRATOR_PORT=8955
PROD_PUBLIC_API_BASE_URL=https://example.com/api/v1
PROD_PUBLIC_SERVICES_API_BASE_URL=https://example.com:8954
PROD_PUBLIC_ORCHESTRATOR_API_BASE_URL=https://example.com:8955
BACKEND_PROD_SENTRY_DSN=CHANGE_ME
BACKEND_PROD_SENTRY_TRACES_SAMPLE_RATE=0.1

# Image and release placeholders
BACKEND_IMAGE=ghcr.io/example/warehub-backend
FRONTEND_IMAGE=ghcr.io/example/warehub-frontend
MOBILE_IMAGE=ghcr.io/example/warehub-mobile
SERVICES_IMAGE=ghcr.io/example/warehub-database-service
ORCHESTRATOR_IMAGE=ghcr.io/example/warehub-orchestrator
BACKEND_APP_VERSION=v0.0.0
FRONTEND_APP_VERSION=v0.0.0
MOBILE_APP_VERSION=v0.0.0
SERVICES_APP_VERSION=v0.0.0
ORCHESTRATOR_APP_VERSION=v0.0.0

# Dynamic source families documented here as patterns, not concrete site values:
# JV_SITE_KEYS=JV_DE,JV_AT,...
# XL_SOURCE_<SITE>_DB_HOST=CHANGE_ME
# XL_SOURCE_<SITE>_DB_USER=CHANGE_ME
# XL_SOURCE_<SITE>_DB_PASSWORD=CHANGE_ME
# XL_SOURCE_<SITE>_DB_NAME=CHANGE_ME
# XL_SOURCE_<SITE>_DB_PORT=3306
# XL_SOURCE_<SITE>_DB_PREFIX=oc_
# JV_SOURCE_<SITE>_DB_HOST=CHANGE_ME
# JV_SOURCE_<SITE>_DB_USER=CHANGE_ME
# JV_SOURCE_<SITE>_DB_PASSWORD=CHANGE_ME
# JV_SOURCE_<SITE>_DB_NAME=CHANGE_ME
# JV_SOURCE_<SITE>_DB_PORT=3306
# JV_SOURCE_<SITE>_DB_PREFIX=oc_
# FTP_<SITE>_URL=https://example.com
# FTP_<SITE>_DOMIN=example.com
# FTP_<SITE>_HOST=CHANGE_ME
# FTP_<SITE>_USER=CHANGE_ME
# FTP_<SITE>_PASS=CHANGE_ME
# FTP_<SITE>_PORT=21
