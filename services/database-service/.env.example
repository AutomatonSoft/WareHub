# XL/JV source OpenCart DB (for sync-by-ean)
# Default fallback per site:
XLJV_SOURCE_XL_DB_HOST=
XLJV_SOURCE_XL_DB_USER=
XLJV_SOURCE_XL_DB_PASSWORD=
XLJV_SOURCE_XL_DB_NAME=
XLJV_SOURCE_XL_DB_PORT=3306
XLJV_SOURCE_XL_DB_PREFIX=oc_
XLJV_SOURCE_JV_DB_HOST=
XLJV_SOURCE_JV_DB_USER=
XLJV_SOURCE_JV_DB_PASSWORD=
XLJV_SOURCE_JV_DB_NAME=
XLJV_SOURCE_JV_DB_PORT=3306
XLJV_SOURCE_JV_DB_PREFIX=oc_

# Optional per-domain override using site_key from query param (?site_key=...)
# Used by "Search All XL Sites":
# XLJV_XL_SITE_KEYS=XLMOEBEL_DE,XLMOEBEL_CH,XLMOBILI_IT
# Pattern: XLJV_SOURCE_<SITE>_<SITE_KEY>_DB_<HOST|USER|PASSWORD|NAME|PORT|PREFIX>
# Example:
# XLJV_SOURCE_XL_XLMOEBEL_DE_DB_HOST=w020e843.kasserver.com
# XLJV_SOURCE_XL_XLMOEBEL_DE_DB_USER=d0455181
# XLJV_SOURCE_XL_XLMOEBEL_DE_DB_PASSWORD=...
# XLJV_SOURCE_XL_XLMOEBEL_DE_DB_NAME=d0455181
# XLJV_SOURCE_XL_XLMOEBEL_DE_DB_PORT=3306
# XLJV_SOURCE_XL_XLMOEBEL_DE_DB_PREFIX=oc_

# Optional JV multi-site override
# XLJV_JV_SITE_KEYS=JV_DE,JV_MAIN,JV_CO_UK,JV_CH,JV_AT
# XLJV_SOURCE_JV_JV_DE_DB_HOST=
# XLJV_SOURCE_JV_JV_DE_DB_USER=
# XLJV_SOURCE_JV_JV_DE_DB_PASSWORD=
# XLJV_SOURCE_JV_JV_DE_DB_NAME=
# XLJV_SOURCE_JV_JV_DE_DB_PORT=3306
# XLJV_SOURCE_JV_JV_DE_DB_PREFIX=oc_

