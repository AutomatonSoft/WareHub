# Local Django service template for WareHub monorepo.
# Copy to an untracked local file only when you need to run the service manually:
#   services/database-service/.env
SECRET_KEY=CHANGE_ME
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

POSTGRES_DB=warehub
POSTGRES_USER=warehub
POSTGRES_PASSWORD=warehub
POSTGRES_HOST=localhost
POSTGRES_PORT=8933
DATABASE_URL=postgresql://warehub:warehub@localhost:8933/warehub

# Optional legacy tunnel mode. Do not use as default.
LEGACY_SHARED_DB_TUNNEL_ENABLED=false
LEGACY_SHARED_DB_TUNNEL_HOST=CHANGE_ME
LEGACY_SHARED_DB_TUNNEL_PORT=CHANGE_ME

# XL/JV source OpenCart DB placeholders
XLJV_SOURCE_XL_DB_HOST=CHANGE_ME
XLJV_SOURCE_XL_DB_USER=CHANGE_ME
XLJV_SOURCE_XL_DB_PASSWORD=CHANGE_ME
XLJV_SOURCE_XL_DB_NAME=CHANGE_ME
XLJV_SOURCE_XL_DB_PORT=3306
XLJV_SOURCE_XL_DB_PREFIX=oc_
XLJV_SOURCE_JV_DB_HOST=CHANGE_ME
XLJV_SOURCE_JV_DB_USER=CHANGE_ME
XLJV_SOURCE_JV_DB_PASSWORD=CHANGE_ME
XLJV_SOURCE_JV_DB_NAME=CHANGE_ME
XLJV_SOURCE_JV_DB_PORT=3306
XLJV_SOURCE_JV_DB_PREFIX=oc_

# Batch translation placeholders
OPENAI_API_KEY=CHANGE_ME
OPENAI_TRANSLATION_MODEL=gpt-5-mini
XLJV_FX_API_URL=https://example.com
XLJV_FX_CONNECT_TIMEOUT=5
XLJV_FX_READ_TIMEOUT=15

# HOOD placeholders
HOOD_API_BASE_URL=https://example.com
HOOD_API_PATCH_ENDPOINT=/api/items/by-ean
HOOD_API_CREATE_ENDPOINT=/api/items/by-ean
HOOD_API_CONNECT_TIMEOUT=8
HOOD_API_READ_TIMEOUT=30
HOOD_FTP_HOST=CHANGE_ME
HOOD_FTP_PORT=21
HOOD_FTP_USER=CHANGE_ME
HOOD_FTP_PASSWORD=CHANGE_ME
HOOD_FTP_BASE_DIR=mediawarehub.veloxdesk.com/warehub/dev/images
HOOD_FTP_PUBLIC_BASE_URL=https://mediawarehub.veloxdesk.com/warehub/dev
HOOD_FTP_USE_TLS=false
HOOD_FTP_PASSIVE=true
HOOD_FTP_CONNECT_TIMEOUT=15
HOOD_VALIDATE_UPLOADED_IMAGE_URLS=false
HOOD_LOGIN=CHANGE_ME
HOOD_PASSWORD=CHANGE_ME

# Afterbuy placeholders
AFTERBUY_JV_LOGIN=CHANGE_ME
AFTERBUY_JV_PASS=CHANGE_ME
AFTERBUY_XL_LOGIN=CHANGE_ME
AFTERBUY_XL_PASS=CHANGE_ME
AFTERBUY_JV_LOGIN_URL=https://example.com
AFTERBUY_XL_LOGIN_URL=https://example.com
